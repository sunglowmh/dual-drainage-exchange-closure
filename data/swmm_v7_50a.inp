[PUMPS]
;;Name           From Node      To Node        Pump Curve     Status   Startup  Shutoff
;; Startup/Shutoff are DEPTHS above the wet-well invert (NOT elevations).
;; The pump drives the throttle node, not the outfall directly: the force
;; main between them provides the pipe friction that makes the operating
;; point settle near the rated duty instead of running wide open.
PS1            N900100        N900101        PS1C           ON       2.20     0.90
PS2            N900103        N900104        PS2C           ON       2.20     0.90

[CURVES]
;;Name           Type       X-Value    Y-Value
;;!! For pumps SWMM evaluates the curve as  flow = Y(X)  with the X column
;;   read as HEAD, not as flow (verified empirically with pump_sweep.py).
;;   Points are therefore written as (shutoff-free head, flow):
;;       0            -> maximum flow
;;       duty head    -> rated flow
;;       1.33 x head  -> zero flow
PS1C           PUMP3      0.0000     0.9605
PS1C                      6.0000     0.7222
PS1C                      7.9800     0.0000
PS2C           PUMP3      0.0000     0.0665
PS2C                      4.0000     0.0500
PS2C                      5.3200     0.0000

[CONTROLS]
; Pump duty is handled by the Startup/Shutoff depths in [PUMPS], which
; provides proper hysteresis (on above the start level, off below the stop
; level).  An ELSE-based RULE would re-trip the pump every time step at the
; setpoint, so no rule is emitted here.

